{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "millerpay",
  "account_id": "e78d9d36459fc3337a335673a3638063",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "define": {
    "import.meta.url": "\"file:///bundle/worker.mjs\""
  },
  "alias": {
    "morgan": "./cloudflare/access-log.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "NODE_ENV": "production",
    "VERCEL": "1",
    "USER_APP_URL": "https://millerpay-official.website",
    "ADMIN_APP_URL": "https://millerpay-official.website",
    "PUBLIC_APP_URL": "https://millerpay-official.website"
  }
}
