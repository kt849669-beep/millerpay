  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/miller-pay/",
      "destination": "/miller-pay/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/miller-pay-login-guide/",
      "destination": "/blog/miller-pay-login-guide/index.html"
    },
    {
      "source": "/blog/miller-pay-app-download/",
      "destination": "/blog/miller-pay-app-download/index.html"
    },
    {
      "source": "/blog/miller-pay-usdt-to-inr/",
      "destination": "/blog/miller-pay-usdt-to-inr/index.html"
    },
    {
